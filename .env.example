# Copy this file to ".env" (same folder as package.json) and fill in your values.
# Find both values in Supabase: Project Settings -> API.
#
# IMPORTANT: only the public "anon" key belongs here. NEVER put the
# "service_role" key in this project - it bypasses all security policies.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
